# YOR WALLET — variables d'environnement (EXEMPLE : aucune valeur réelle, aucun secret).
# Copiez en .env.local (jamais commité) ou saisissez ces valeurs comme « secrets » Supabase / Netlify.
# Jamais de clé privée, de phrase de récupération ou de seed dans un fichier du dépôt ni dans le code web.

# development | testnet | production
YOR_ENV=development

# shasta | nile | mainnet.  mainnet est REFUSÉ hors production, et le jeton expérimental est refusé sur mainnet.
TRON_NETWORK=shasta

# Doit valoir true : seul le jeton expérimental « YOR Experimental USDT » (YOR-USDT) est implémenté.
YOR_EXPERIMENTAL_TOKEN=true

# VIDE tant que le contrat n'a pas été réellement déployé sur le réseau choisi.
# Ne jamais inventer ni recopier l'adresse d'un autre jeton (ex. le vrai Tether).
# Testnet Nile : contrat réellement déployé et confirmé le 2026-10-08 (voir docs/TOKEN.md) :
#   YOR_TOKEN_CONTRACT_ADDRESS=TYnzmpqeUWtXWjymVtdj4SADzW45adnzdf   (TRON_NETWORK=nile)
# Laisser vide pour tout autre réseau tant qu'aucun déploiement réel n'y a eu lieu.
YOR_TOKEN_CONTRACT_ADDRESS=

# Optionnel : nœud personnalisé en https (refusé s'il pointe vers le mainnet alors que le réseau est un testnet).
TRON_FULLNODE_URL=

# Optionnel mais recommandé : clé TronGrid gratuite (en-tête TRON-PRO-API-KEY). Secret : ne pas commiter.
TRONGRID_API_KEY=

# Plafond de frais (en sun) pour les transactions de contrat. VIDE = refus de construire une transaction :
# aucune valeur n'est inventée par le code.
YOR_FEE_LIMIT_SUN=

# Réservé à la production sur mainnet (actuellement impossible pour le jeton expérimental).
YOR_ALLOW_MAINNET=

# Fonctions Edge Supabase (secrets, jamais dans le dépôt) :
#   TRONGRID_API_KEY, YOR_TOKEN_CONTRACT_ADDRESS, YOR_SIGNING_PROVIDER
# Tant que YOR_SIGNING_PROVIDER n'est pas défini, l'interface doit afficher :
#   "Wallet signing provider not configured"
