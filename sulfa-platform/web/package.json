{
  "name": "sulfa-web",
  "version": "1.0.0",
  "private": true,
  "description": "SULFA \u2014 \u0633\u0644\u0641\u0647 : site public, espace client et centre d'administration (Next.js, export statique, Supabase)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:sql": "bash ../supabase/tests/run.sh",
    "check:connected": "node scripts/connected-check.mjs",
    "build:e2e": "NEXT_PUBLIC_SUPABASE_URL=https://sulfa-e2e.supabase.co NEXT_PUBLIC_SUPABASE_ANON_KEY=e2e-anon-key next build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/readex-pro": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/tajawal": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
