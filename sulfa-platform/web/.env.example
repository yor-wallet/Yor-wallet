# Copy to .env.local and fill in. Only PUBLIC values go here: they are compiled into the browser bundle.
# NEVER put the service_role key, a database password or any provider secret in this file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Optional: public support address shown on the Contact page (leave empty to hide it)
NEXT_PUBLIC_SUPPORT_EMAIL=
